# EasyEssay 配置示例 —— 复制为 .env 后填写。
# 也可以完全不改这里：打开网页后会有「开始使用」弹层让你填 Key（存到 data/settings.json）。

# DeepSeek API Key（翻译与问答都需要）
DEEPSEEK_API_KEY=

# 接口地址（OpenAI 兼容）：
#   DeepSeek       https://api.deepseek.com
#   硅基流动        https://api.siliconflow.cn/v1
#   本地 Ollama     http://127.0.0.1:11434/v1
EE_BASE_URL=https://api.deepseek.com

# 模型名
EE_MODEL=deepseek-chat

# 监听地址与端口（默认只绑本机；0.0.0.0 表示同一局域网的别人也能访问）
# EE_HOST=127.0.0.1
# PORT=8765
